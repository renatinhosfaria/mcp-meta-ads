# ============================================================
# Configuração do Servidor HTTP
# ============================================================

# Porta do servidor (padrão: 3200)
PORT=3200

# API Key para autenticação Bearer (gere com: openssl rand -hex 32)
API_KEY=

# Rate limit: requisições por minuto (padrão: 60)
RATE_LIMIT_RPM=60

# Sessões MCP stateful: expiração ociosa, capacidade e alerta
MCP_SESSION_IDLE_TTL_MS=1800000
MCP_MAX_SESSIONS=250
MCP_SESSION_ALERT_THRESHOLD=150

# Alerta de heap exibido pelo health check (300 MiB)
MCP_HEAP_ALERT_BYTES=314572800

# O keep-alive do Node deve ser maior que o idleConnTimeout de 90s do Traefik
HTTP_KEEP_ALIVE_TIMEOUT_MS=95000
HTTP_HEADERS_TIMEOUT_MS=100000

# Prazo para encerrar sessões e conexões durante SIGTERM
SHUTDOWN_GRACE_MS=10000

# ============================================================
# Meta Marketing API Credentials
# Obtenha em: https://developers.facebook.com/apps/

# Token de acesso de longa duração (System User Token recomendado para produção)
# Permissões necessárias: ads_management, ads_read, business_management, read_insights
META_ACCESS_TOKEN=

# ID da conta de anúncio padrão (formato: act_XXXXXXXXXX)
# Encontre em: Meta Business Manager > Configurações > Contas de Anúncio
META_AD_ACCOUNT_ID=act_

# ID do app registrado no Meta Developers
META_APP_ID=

# Secret do app (Meta Developers > Configurações Básicas)
META_APP_SECRET=

# Versão da Graph API (padrão: v21.0)
META_API_VERSION=v21.0

# ID do Business Manager (opcional, para listar contas vinculadas)
META_BUSINESS_ID=

# ============================================================
# Instagram (opcional; veja docs/instagram-setup.md)
# ============================================================

# ID da conta profissional do Instagram usada por padrão nas ferramentas meta_ig_*
META_IG_USER_ID=

# ID da Página do Facebook vinculada ao Instagram (padrão das ferramentas que usam a Página)
META_PAGE_ID=

# Texto secreto que você inventa; a Meta o devolve ao verificar GET /webhooks/meta (gere com: openssl rand -hex 24)
META_WEBHOOK_VERIFY_TOKEN=

# Pasta onde ficam o banco SQLite (eventos, destinos) e os uploads temporários.
# scripts/deploy.sh usa /app/data dentro do container.
DATA_DIR=./data

# URL pública do servidor (https), usada nos links de /media
PUBLIC_BASE_URL=https://seu-dominio.exemplo.com.br

# OAuth 2.1 do ChatGPT via Auth0 (opcional; informe issuer e audience juntos)
# Ex.: https://seu-tenant.eu.auth0.com/
AUTH0_ISSUER=
# Identificador HTTPS da API criada no Auth0
AUTH0_AUDIENCE=
# Resource OAuth; padrão: PUBLIC_BASE_URL
AUTH0_RESOURCE=
# Scopes exigidos no access token; separados por espaço (padrão: mcp:access)
AUTH0_REQUIRED_SCOPES=mcp:access
